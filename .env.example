# Environment Configuration
# Copy this file to .env and modify as needed

NODE_ENV=development

# Server port (default: 3050)
PORT=3050

# Bind address — defaults to 127.0.0.1 (loopback only) for safety.
# Production deployments behind nginx/Cloudflare should keep this as-is.
# Set to 0.0.0.0 only if you intentionally want to expose OpenGem directly.
# HOST=127.0.0.1

# OAuth redirect URI.
# The built-in Antigravity OAuth client accepts loopback redirects, not arbitrary domains.
# Hosted deployments can still complete OAuth by pasting the loopback callback URL
# into the Accounts page after Google redirects the browser.
# OAUTH_REDIRECT_URI=http://127.0.0.1:3050/api/auth/callback

# Optional path to Chromium for proxied auth browser sessions.
# Docker sets this to /usr/bin/chromium.
# AUTH_BROWSER_CHROMIUM_PATH=/usr/bin/chromium
# Set to true only if you explicitly want headless Chromium instead of Xvfb-backed browser sessions.
# AUTH_BROWSER_HEADLESS=false

# Account Safety Mode prevents suspicious account bursts.
# It is enabled by default and blocks direct Google egress elsewhere in the app.
# ACCOUNT_SAFETY_MODE=true
# ACCOUNT_SAFETY_MAX_CONCURRENT_PER_ACCOUNT=1
# ACCOUNT_SAFETY_MIN_SPACING_MS=2000
# ACCOUNT_SAFETY_MAX_REQUESTS_PER_HOUR=60
# ACCOUNT_SAFETY_MAX_REQUESTS_PER_DAY=300
# ACCOUNT_SAFETY_LOG_SCAN_LIMIT=5000

# Allowed CORS origins in production (comma-separated)
# CORS_ORIGIN=https://yourdomain.com

# Config encryption key — auto-generated on first run if not set.
# This key is used to encrypt/decrypt sensitive values in config.json.
# ⚠️  DO NOT SHARE, COMMIT, OR LOSE THIS KEY.
# If lost, you will need to re-run setup to generate a new config.
# CONFIG_ENCRYPTION_KEY=<auto-generated-128-char-hex-string>
